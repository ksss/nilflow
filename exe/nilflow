#!/usr/bin/env ruby
require_relative "../lib/nilflow"

usage = <<~USAGE
  usage:
    nilflow build DIR... [-o graph.db] [--collection rbs_collection.yaml]
                                         analyze .rb/.rbs under DIR and write SQLite
    nilflow stats [graph.db]             show coverage (per call)
    nilflow why FILE:LINE:COL [graph.db] show the paths by which nil reaches the position
    nilflow nil-receivers [--all] [graph.db]
                                         list calls whose receiver may be nil (--all includes guarded ones)
    nilflow calls FILE:LINE [graph.db]   show the resolved targets of calls on the line
  for agents (concise output: file:line and types):
    nilflow callers Klass#mid [graph.db] type-resolved call sites, plus the number of unresolved same-named calls
    nilflow callees FILE:LINE [graph.db] receiver type, resolved targets and confidence of each call on the line
    nilflow type-at FILE:LINE:COL [graph.db] type and confidence of the expression at the position
    nilflow why FILE:LINE:COL [--type T] [graph.db] provenance of a value (nil by default)
    nilflow summary FILE[:FROM:TO] [graph.db]  one line per call in the file or range (for hook injection)
USAGE

cmd, *args = ARGV
db = "graph.db"
# Resolve relative paths against NILFLOW_ROOT (the analyzed repository), so they work even when a wrapper changes cwd.
def expand(file) = File.expand_path(file, ENV["NILFLOW_ROOT"] || Dir.pwd)
# Print paths relative to the repository (easier for agents to read)
def short(path) = path.to_s.gsub("#{ENV['NILFLOW_ROOT']}/", "").gsub(%r{\S*/gems/rbs-[^/]*/}, "rbs:")
at_exit { $stdout.flush }
case cmd
when "build"
  dirs = []
  collection = nil
  until args.empty?
    case (a = args.shift)
    when "-o" then db = args.shift
    when "--collection" then collection = File.expand_path(args.shift)
    else dirs << File.expand_path(a)
    end
  end
  abort usage if dirs.empty?
  t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  service = Nilflow.analyze(dirs, collection: collection)
  t1 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  Nilflow::Exporter.new(service, db).run
  t2 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  $stderr.puts "analyze %.1fs, export %.1fs" % [t1 - t0, t2 - t1]
  s = SQLite3::Database.new(db)
  puts "wrote #{db}: " + %w[vertices type_flow call_sites calls].map { |t| "#{t}=#{s.get_first_value("SELECT count(*) FROM #{t}")}" }.join(", ")
when "why"
  pos = args.shift or abort usage
  type = (i = args.index("--type")) ? args.slice!(i, 2).last : nil
  db = args.shift || db
  file, line, col = pos.split(":")
  q = Nilflow::Query.new(db)
  if type
    v = q.type_at(expand(file), line.to_i, col.to_i)
    abort "no vertex at #{pos}" unless v
    preds = Hash.new { |h, k| h[k] = [] }
    q.origin_edges(v["id"], type).each { |e| preds[e["dst"]] << e["src"] }
    puts "#{type} reaches [#{v['id']}] #{v['origin']} @ #{File.basename(v['path'])}:#{v['line']}:#{v['col']} : #{v['types']}"
    q.send(:print_tree, v["id"], preds, Set.new, 1, $stdout)
  else
    q.explain(expand(file), line.to_i, col.to_i)
  end
when "callers"
  target = args.shift or abort usage
  db = args.shift || db
  q = Nilflow::Query.new(db)
  rows, unresolved = q.callers(target)
  rows.each do |r|
    m = q.method_at(r["path"], r["line"])
    puts "#{short(r['path'])}:#{r['line']}  in #{m || '(toplevel)'}  recv=#{r['types']}  [#{q.confidence_of(r['types'])}]"
  end
  d = rows.first
  puts "defined at #{short(d['def_path'])}:#{d['def_line']}" if d && d["def_path"]
  puts "(#{rows.size} resolved callers; #{unresolved} calls named .#{target.split(/[#.]/).last} could not be resolved and are not listed)"
when "callees"
  pos = args.shift or abort usage
  db = args.shift || db
  file, line = pos.split(":")
  q = Nilflow::Query.new(db)
  rows = q.callees(expand(file), line.to_i)
  puts "no calls on that line" if rows.empty?
  rows.each do |r|
    puts "col #{r['col']} .#{r['mid']}  recv=#{r['types'] || 'untyped'}  [#{q.confidence_of(r['types'])}]"
    (r["targets"] || "  unresolved").split("\n").each { |t| puts "    -> #{short(t)}" }
  end
when "summary"
  pos = args.shift or abort usage
  db = args.shift || db
  file, from, to = pos.split(":")
  q = Nilflow::Query.new(db)
  q.root = ENV["NILFLOW_ROOT"]
  puts q.summary(expand(file), from&.to_i, to&.to_i)
when "type-at"
  pos = args.shift or abort usage
  db = args.shift || db
  file, line, col = pos.split(":")
  q = Nilflow::Query.new(db)
  v = q.type_at(expand(file), line.to_i, col.to_i)
  if v
    puts "#{v['origin']} @ #{file}:#{v['line']}:#{v['col']}-#{v['end_line']}:#{v['end_col']}  : #{v['types']}  [#{q.confidence_of(v['types'])}]"
  else
    puts "no typed expression at #{pos}"
  end
when "stats"
  db = args.shift || db
  Nilflow::Query.new(db).stats.each { |k, v| puts "%-18s %d" % [k, v] }
when "nil-receivers"
  all = args.delete("--all")
  db = args.shift || db
  Nilflow::Query.new(db).nil_receivers(include_guarded: !!all).each do |r|
    puts "#{short(r['path'])}:#{r['line']}:#{r['col']}  .#{r['mid']}  recv=[#{r['recv']}] #{r['types']}"
  end
when "calls"
  pos = args.shift or abort usage
  db = args.shift || db
  file, line = pos.split(":")
  Nilflow::Query.new(db).calls_at(expand(file), line.to_i).each do |r|
    puts "col #{r['col']} .#{r['mid']} -> #{r['target']} (#{r['target_kind']}) #{short(r['tpath'])}:#{r['tline']}"
  end
else
  abort usage
end
